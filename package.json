{
  "name": "systemcraft-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:api": "pnpm --filter @systemcraft/api dev",
    "dev:web": "pnpm --filter @systemcraft/web dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
